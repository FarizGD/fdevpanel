{
  "name": "fdevpanel-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive static FDevPanel showcase for GitHub Pages",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:panel": "NODE_OPTIONS=--max-old-space-size=1400 WEBPACK_PUBLIC_PATH=/fdevpanel/demo/assets/ yarn --cwd panel-demo build:production",
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/serve.mjs",
    "check": "npm test && npm run build"
  }
}
